# copie para .env (carregado automaticamente) — nunca versione o arquivo real.
# Alternativas: exportar no shell ou .streamlit/secrets.toml (GEMINI_API_KEY = "sua-chave").
GEMINI_API_KEY=sua-chave-aqui
# opcional
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-2
# caminho do lilypond.exe, se não estiver no PATH (gravação em PDF; mínimo 2.25.26)
# LILYPOND=C:/caminho/lilypond-2.26.0/bin/lilypond.exe

# Experimental desktop integration; disabled by default
MUSCHAT_OPENMUSIC=0
