# Configure a chave de UMA destas formas (nunca versione o arquivo real):
#  1) .streamlit/secrets.toml  ->  GEMINI_API_KEY = "sua-chave"
#  2) exporte no shell, ou copie este arquivo para .env e rode:
#     uv run --env-file .env streamlit run app.py
GEMINI_API_KEY=sua-chave-aqui
# opcional
GEMINI_MODEL=gemini-3.1-flash-lite
