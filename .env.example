# copie para .env (carregado automaticamente) — nunca versione o arquivo real.
# Alternativas: exportar no shell ou .streamlit/secrets.toml (GEMINI_API_KEY = "sua-chave").
GEMINI_API_KEY=sua-chave-aqui
# opcional
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-2
# caminho do lilypond.exe, se não estiver no PATH (gravação em PDF; mínimo 2.25.26)
# LILYPOND=C:/caminho/lilypond-2.26.0/bin/lilypond.exe

# integração experimental com o OpenMusic (desktop); desligada por padrão, 1 liga
MUSCHAT_OPENMUSIC=0

# NotaGen (modelo local de composição, GPU de 8 GB); desligado por padrão, 1 liga (instalação no README)
MUSCHAT_NOTAGEN=0
# NOTAGEN_PYTHON=.muschat/notagen/venv/Scripts/python.exe
# NOTAGEN_DIR=.muschat/notagen/NotaGen
